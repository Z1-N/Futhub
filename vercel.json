{
  "version": 2,
  "rewrites": [
    { "source": "/api/:match*", "destination": "/api/:match*" },
    { "source": "/assets/:match*", "destination": "/assets/:match*" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/:match*", "destination": "/index.html" }
  ]
}
